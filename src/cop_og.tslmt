var Int cop_x
var Int cop_y

var Int robber_x
var Int robber_y

SPECIFICATION

assume {
  // Cop One
  gte cop_x i0() && gte cop_y i0();
  lte cop_x i3() && lte cop_y i3();

  eq robber_x i3() && eq robber_y i3();

}

always guarantee {
  // Cop One
  gte cop_x i0() && gte cop_y i0();
  lte cop_x i3() && lte cop_y i3();

  // Cop One Movement
  ([cop_x <- cop_x] || [cop_x <- add cop_x i1()] || [cop_x <- sub cop_x i1()]);
  ([cop_y <- cop_y] || [cop_y <- add cop_y i1()] || [cop_y <- sub cop_y i1()]);

  F (eq cop_x robber_x && eq cop_y robber_y);
}