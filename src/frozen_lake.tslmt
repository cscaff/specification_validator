var Int playerX
var Int playerY

SPECIFICATION

// Goal
goalX = i3();
goalY = i3();

// Bounds
inbounds = (gte playerX i0() && lte playerX i3()) && (gte playerY i0() && lte playerY i3());
avoid_holes = ! ((eq playerX i1() && eq playerY i1()) || 
                (eq playerX i3() && eq playerY i1())  ||
                (eq playerX i3() && eq playerY i2())  ||
                (eq playerX i0() && eq playerY i3()));

// Movements
moveL = [playerX <- sub playerX i1()] && [playerY <- playerY];
moveR = [playerX <- add playerX i1()] && [playerY <- playerY];
moveU = [playerX <- playerX] && [playerY <- sub playerY i1()];
moveD = [playerX <- playerX] && [playerY <- add playerY i1()];

assume {
    // eq playerX i0() && eq playerY i0();
    // inbounds && avoid_holes;
    inbounds;
}

always guarantee {
    // Grid Bounds
    // X (inbounds && avoid_holes);
    inbounds;

    // Functions
    moveL || moveR || moveU || moveD;

    // Mutual Exclusion of Movements
    !(moveL && moveU) && !(moveL && moveD);
    !(moveR && moveU) && !(moveR && moveD);
}


guarantee {
    // Objective
    F ((eq playerX goalX) && (eq playerY goalY));
}