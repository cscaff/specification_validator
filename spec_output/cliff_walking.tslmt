var Int x
var Int y
var Bool atGoal


SPECIFICATION

/* Cliff Walking: Robot navigates 4x12 grid avoiding cliff to reach the goal */
/* Grid: 4 rows (0-3) x 12 columns (0-11) */
/* Start: (0,0) bottom-left, Goal: (11,0) bottom-right */
/* Cliff: x in [1,10] at y=0 - must avoid! */

/* Grid bounds */
MIN_X = i0();
MAX_X = i11();
MIN_Y = i0();
MAX_Y = i3();

/* Goal position */
GOAL_X = i11();
GOAL_Y = i0();

/* Cliff boundaries (y=0, x from 1 to 10) */
CLIFF_Y = i0();
CLIFF_X_MIN = i1();
CLIFF_X_MAX = i10();

/* Movement predicates */
stayX = [x <- x];
stayY = [y <- y];
moveRight = [x <- add x i1()];
moveLeft = [x <- sub x i1()];
moveUp = [y <- add y i1()];
moveDown = [y <- sub y i1()];

/* Position predicates */
atGoalPos = (eq x GOAL_X) && (eq y GOAL_Y);
inBounds = (gte x MIN_X) && (lte x MAX_X) && (gte y MIN_Y) && (lte y MAX_Y);
goal_inBounds = (gte GOAL_X MIN_X) && (lte GOAL_X MAX_X) && (gte GOAL_Y MIN_Y) && (lte GOAL_Y MAX_Y);

/* Cliff check: on cliff if y=0 and 1 <= x <= 10 */
onCliff = (eq y CLIFF_Y) && (gte x CLIFF_X_MIN) && (lte x CLIFF_X_MAX);

/* Next position predicates for checking moves */
nextXRight = add x i1();
nextXLeft = sub x i1();
nextYUp = add y i1();
nextYDown = sub y i1();

/* Safe move checks - don't move into cliff */
/* Cliff is at y=0, x in [1,10] */
safeRight = !((eq y CLIFF_Y) && (gte nextXRight CLIFF_X_MIN) && (lte nextXRight CLIFF_X_MAX));
safeLeft = !((eq y CLIFF_Y) && (gte nextXLeft CLIFF_X_MIN) && (lte nextXLeft CLIFF_X_MAX));
safeUp = !((eq nextYUp CLIFF_Y) && (gte x CLIFF_X_MIN) && (lte x CLIFF_X_MAX));
safeDown = !((eq nextYDown CLIFF_Y) && (gte x CLIFF_X_MIN) && (lte x CLIFF_X_MAX));

assume {
    inBounds;
    !onCliff;
    goal_inBounds;
}

guarantee {
    /* Initial state */
    stayX && stayY && [atGoal <- false];

    /* Stay in bounds */
    G inBounds;

    /* Never on the cliff */
    G !onCliff;

    /* Movement: exactly one direction or stay */
    X G ((stayX && stayY) ||
         (moveRight && stayY && (lt x MAX_X) && safeRight) ||
         (moveLeft && stayY && (gt x MIN_X) && safeLeft) ||
         (stayX && moveUp && (lt y MAX_Y) && safeUp) ||
         (stayX && moveDown && (gt y MIN_Y) && safeDown));

    /* Goal flag: set when reaching goal */
    X G (atGoalPos -> [atGoal <- true]);
    X G (atGoal -> [atGoal <- true]);
    X G (!atGoalPos && !atGoal -> [atGoal <- false]);

    /* Once at goal, stay there */
    X G (atGoal -> stayX && stayY);

    /* Liveness: eventually reach the goal */
    F atGoal;

}

{{GUARANTEE_BLOCK}}
