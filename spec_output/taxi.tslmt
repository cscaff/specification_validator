var Int x
var Int y
var Bool hasPassenger
var Bool delivered

SPECIFICATION

/* Grid: 5x5 (0-4) */
MINB = i0();
MAXB = i4();

/* Taxi start */
START_X = i2();
START_Y = i2();

/* Fixed locations: Pickup at (0,0), Dest at (4,4) */
PICKUP_X = i0();
PICKUP_Y = i0();
DEST_X = i4();
DEST_Y = i4();

/* Barrier */
BAR_X = i1();
BAR_Y = i2();

/* Position checks */
inBounds = (gte x MINB) && (lte x MAXB) && (gte y MINB) && (lte y MAXB);
atBarrier = (eq x BAR_X) && (eq y BAR_Y);
atPickup = (eq x PICKUP_X) && (eq y PICKUP_Y);
atDest = (eq x DEST_X) && (eq y DEST_Y);

/* Movement */
stayX = [x <- x];
stayY = [y <- y];
moveRight = [x <- add x i1()];
moveLeft = [x <- sub x i1()];
moveUp = [y <- add y i1()];
moveDown = [y <- sub y i1()];

/* Safe moves */
nxR = add x i1();
nxL = sub x i1();
nyU = add y i1();
nyD = sub y i1();

safeR = !((eq nxR BAR_X) && (eq y BAR_Y));
safeL = !((eq nxL BAR_X) && (eq y BAR_Y));
safeU = !((eq x BAR_X) && (eq nyU BAR_Y));
safeD = !((eq x BAR_X) && (eq nyD BAR_Y));

assume {
    (eq x START_X);
    (eq y START_Y);
}

guarantee {
    /* Initial */
    stayX && stayY && [hasPassenger <- false] && [delivered <- false];

    /* Safety */
    G inBounds;
    G !atBarrier;

    /* Movement */
    X G ((stayX && stayY) ||
         (moveRight && stayY && (lt x MAXB) && safeR) ||
         (moveLeft && stayY && (gt x MINB) && safeL) ||
         (stayX && moveUp && (lt y MAXB) && safeU) ||
         (stayX && moveDown && (gt y MINB) && safeD));

    /* Pickup */
    X G (!hasPassenger && !delivered && atPickup -> [hasPassenger <- true] && [delivered <- false]);
    X G (!hasPassenger && !delivered && !atPickup -> [hasPassenger <- false] && [delivered <- false]);

    /* Dropoff */
    X G (hasPassenger && !delivered && atDest -> [hasPassenger <- false] && [delivered <- true]);
    X G (hasPassenger && !delivered && !atDest -> [hasPassenger <- true] && [delivered <- false]);

    /* Done */
    X G (delivered -> [hasPassenger <- false] && [delivered <- true] && stayX && stayY);

    /* Liveness */
    F delivered;
}

{{GUARANTEE_BLOCK}}
